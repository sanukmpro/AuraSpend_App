<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Background rounded squircle with dark obsidian aura -->
    <path
        android:pathData="M 28,10 L 80,10 C 94,10 98,14 98,28 L 98,80 C 98,94 94,98 80,98 L 28,98 C 14,98 10,94 10,80 L 10,28 C 10,14 14,10 28,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="10"
                android:endX="98"
                android:endY="98"
                android:type="linear">
                <item android:offset="0.0" android:color="#2A134D" />
                <item android:offset="0.5" android:color="#170A2E" />
                <item android:offset="1.0" android:color="#0A0414" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer border highlight -->
    <path
        android:pathData="M 28,10 L 80,10 C 94,10 98,14 98,28 L 98,80 C 98,94 94,98 80,98 L 28,98 C 14,98 10,94 10,80 L 10,28 C 10,14 14,10 28,10 Z"
        android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="10"
                android:startY="10"
                android:endX="98"
                android:endY="98"
                android:type="linear">
                <item android:offset="0.0" android:color="#A56CFF" />
                <item android:offset="0.5" android:color="#4F268A" />
                <item android:offset="1.0" android:color="#1A0D30" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ambient glowing aura circle (large) -->
    <path
        android:pathData="M 54,54 m -30,0 a 30,30 0 1,1 60,0 a 30,30 0 1,1 -60,0"
        android:fillAlpha="0.18"
        android:fillColor="#8C43FF" />

    <!-- Ambient glowing aura circle (inner bright) -->
    <path
        android:pathData="M 54,54 m -20,0 a 20,20 0 1,1 40,0 a 20,20 0 1,1 -40,0"
        android:fillAlpha="0.32"
        android:fillColor="#BD8BFF" />

    <!-- Small Accent Sparkle (Top-Right) -->
    <path
        android:pathData="M 78,28 Q 78,34 72,34 Q 78,34 78,40 Q 78,34 84,34 Q 78,34 78,28 Z"
        android:fillColor="#EEDEFF" />

    <!-- Small Accent Sparkle (Bottom-Left) -->
    <path
        android:pathData="M 30,72 Q 30,76 26,76 Q 30,76 30,80 Q 30,76 34,76 Q 30,76 30,72 Z"
        android:fillColor="#D0A8FF" />

    <!-- Main Aura 4-Point Star Emblem -->
    <path
        android:pathData="M 54,22 Q 54,54 22,54 Q 54,54 54,86 Q 54,54 86,54 Q 54,54 54,22 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="30"
                android:endX="76"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.3" android:color="#E9D6FF" />
                <item android:offset="0.7" android:color="#B87DFF" />
                <item android:offset="1.0" android:color="#7731E6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Core light diamond highlight -->
    <path
        android:pathData="M 54,44 L 64,54 L 54,64 L 44,54 Z"
        android:fillAlpha="0.45"
        android:fillColor="#FFFFFF" />

</vector>
