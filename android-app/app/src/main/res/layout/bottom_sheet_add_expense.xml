<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/addSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <!-- Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_handle" />

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="NEW"
                android:textColor="#A990BF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/addSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add expense"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/addSheetClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:text="✕"
            android:textColor="#CDB9DA"
            android:textSize="16sp" />
    </RelativeLayout>

    <!-- Amount input with currency label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Amount"
        android:textColor="#A997B5"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/addAmountCurrency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$"
            android:textColor="#D9B8FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/addAmountInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:paddingStart="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6D5D7E"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Category Grid label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Category"
        android:textColor="#A997B5"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 3x2 Category Grid -->
    <GridLayout
        android:id="@+id/addCategoryGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:columnCount="3"
        android:rowCount="2">

        <!-- Food -->
        <LinearLayout
            android:id="@+id/catFood"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_category_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍔"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food"
                android:textColor="#A99DB8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Transport -->
        <LinearLayout
            android:id="@+id/catTransport"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_category_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚗"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transport"
                android:textColor="#A99DB8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Rent -->
        <LinearLayout
            android:id="@+id/catRent"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_category_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rent"
                android:textColor="#A99DB8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Fun -->
        <LinearLayout
            android:id="@+id/catFun"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_category_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fun"
                android:textColor="#A99DB8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Utilities -->
        <LinearLayout
            android:id="@+id/catUtilities"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_category_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Utilities"
                android:textColor="#A99DB8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Others -->
        <LinearLayout
            android:id="@+id/catOthers"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_category_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Others"
                android:textColor="#A99DB8"
                android:textSize="11sp" />
        </LinearLayout>
    </GridLayout>

    <!-- Date and Description Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Date"
                android:textColor="#A997B5"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/addDateInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:clickable="true"
                android:focusable="false"
                android:hint="YYYY-MM-DD"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6D5D7E"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Description"
                android:textColor="#A997B5"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/addDescriptionInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="Optional"
                android:inputType="textCapSentences"
                android:maxLength="80"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6D5D7E"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Error message -->
    <TextView
        android:id="@+id/addFormError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:textColor="#FF6D93"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Submit Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/addSubmitBtn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_primary_button"
        android:text="Add expense"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
