<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090414">

    <!-- Ambient top-left background glow orb -->
    <View
        android:id="@+id/ambientGlowTop"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="-60dp"
        android:layout_marginTop="-60dp"
        android:background="@drawable/bg_splash_glow"
        android:alpha="0" />

    <!-- Ambient bottom-right background glow orb -->
    <View
        android:id="@+id/ambientGlowBottom"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="-80dp"
        android:layout_marginBottom="-80dp"
        android:background="@drawable/bg_splash_glow"
        android:alpha="0" />

    <!-- Center content container -->
    <LinearLayout
        android:id="@+id/splashCenterContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Logo Container with pulsating Aura Halo -->
        <RelativeLayout
            android:id="@+id/logoContainer"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:gravity="center">

            <!-- Pulsing Aura Halo ring behind logo -->
            <View
                android:id="@+id/splashHaloRing"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_splash_glow"
                android:alpha="0" />

            <!-- Core App Logo Image -->
            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_centerInParent="true"
                android:contentDescription="AuraSpend Logo"
                android:src="@drawable/app_logo"
                android:elevation="8dp" />
        </RelativeLayout>

        <!-- Brand Title -->
        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.04"
            android:text="AuraSpend"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:alpha="0" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Smart money, simple life."
            android:textColor="#A99DB8"
            android:textSize="13sp"
            android:alpha="0" />
    </LinearLayout>

    <!-- Bottom boot loading indicator -->
    <LinearLayout
        android:id="@+id/splashBottomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="vertical"
        android:alpha="0">

        <!-- Mini shimmering progress line -->
        <ProgressBar
            android:id="@+id/splashProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:indeterminateTint="#A56CFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.1"
            android:text="STANDALONE OFFLINE EDITION"
            android:textColor="#665979"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
